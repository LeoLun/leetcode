{
  "name": "leetcode",
  "version": "1.0.0",
  "description": "leetcode",
  "keywords": [
    "leetcode"
  ],
  "scripts": {
    "test": "node ./scripts/test.cjs",
    "test:all": "vitest run ./src",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "tsgo --noEmit -p tsconfig.json",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run format:check && pnpm run test:all"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "@typescript/native-preview": "7.0.0-dev.20260621.1",
    "oxfmt": "^0.55.0",
    "oxlint": "^1.70.0",
    "oxlint-tsgolint": "^0.23.0",
    "vitest": "^4.1.9"
  }
}
